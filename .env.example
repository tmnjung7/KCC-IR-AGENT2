# ── LLM API 키 (최소 하나 필수) ──────────────────────────────────────────────
# Gemini: https://aistudio.google.com 에서 발급
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# Claude (선택): https://console.anthropic.com 에서 발급
# 설정하면 UI에 Gemini/Claude 전환 토글이 나타납니다.
# LITE=Claude Haiku 4.5, FLASH=Claude Sonnet 5, PRO=Claude Opus 5
ANTHROPIC_API_KEY=""

# ── DART 전자공시 자동 연동 (권장) ───────────────────────────────────────────
# https://opendart.fss.or.kr 에서 무료 발급 (일 20,000건 조회)
# 설정하면 재무제표·재무지표·배당·최근공시가 자동 수집됩니다 (6시간 캐시).
# 미설정 시 기존처럼 GitHub 저장소의 CSV만 사용합니다.
DART_API_KEY=""

# (선택) DART 고유번호 8자리를 직접 지정하면 종목코드 조회 과정을 생략합니다.
# DART_CORP_CODE=""
# (선택) 종목코드. 기본값 002380 (KCC)
# DART_STOCK_CODE="002380"

# ── KCC 뉴스 (선택) ──────────────────────────────────────────────────────────
# 미설정 시 키가 필요 없는 Google News RSS를 사용합니다.
# 네이버 뉴스 검색 API를 쓰려면 https://developers.naver.com 에서 애플리케이션
# 등록 후 아래 두 값을 설정하세요.
# NAVER_CLIENT_ID=""
# NAVER_CLIENT_SECRET=""

# APP_URL: The URL where this applet is hosted.
APP_URL="MY_APP_URL"
